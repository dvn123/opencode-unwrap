{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(gh api *)",
      "Bash(rg *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(fd *)",
      "Bash(head *)",
      "Bash(mktemp *)",
      "Edit(**)",
      "Edit(//tmp/**)",
      "Bash(setopt pipefail)",
      "Bash(cd *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -* push *)",
      "Edit(**/*.lock)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(find *)",
      "Bash(python3 - *)",
      "Bash(git clean *)",
      "Bash(git -* clean *)",
      "Bash(gh api -X POST *)",
      "Bash(gh api --method POST *)",
      "Bash(git rebase -i *)",
      "Read(//**/.env)",
      "Edit(//**/.env)",
      "Read(~/.ssh/**)",
      "Bash(*SECRET_TOKEN*)",
      "Bash(rg * --pre *)",
      "Bash(git*core.pager*)",
      "Bash(git*ext::*)",
      "Bash(git config*alias.*)",
      "Bash(git -* config*alias.*)"
    ],
    "additionalDirectories": [
      "{extra}"
    ]
  },
  "reasons": {
    "rm *": "use trash",
    "python3 - *": "write a script"
  }
}
