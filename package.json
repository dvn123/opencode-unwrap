{
  "name": "opencode-unwrap",
  "version": "0.1.0",
  "description": "OpenCode plugin that applies shell permission rules to wrapped commands",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && bun test",
    "test": "bun test",
    "build": "bun build src/index.ts --target bun --outfile dist/opencode-unwrap.js"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.15",
    "@opencode/schema": "2.0.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
